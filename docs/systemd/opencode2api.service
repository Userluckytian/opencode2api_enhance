# opencode2api 管理器 systemd 服务模板 —— deb 安装版（Linux headless）
#
# 适用：Debian 13+ / Ubuntu 22.04+ 通过 .deb 安装的 opencode2api。
# deb 包将二进制装到 /usr/bin/opencode2api。
#
# ⚠️ 自 v1.5.3 起：deb 包已内置本服务并自动注册（随包装入
#    /etc/systemd/system/opencode2api.service），无需手动复制本文件！
#    安装 deb 后直接：
#       sudo systemctl status opencode2api
#    首次建议先修改 /etc/opencode2api/manager.env（端口/监听地址/数据目录；
#    统一网关密钥默认 sk-unified-local 无需修改，如需自定义在 WebUI「统一网关」
#    卡片设置；管理 WebUI 鉴权默认关闭——core 默认空密码，不在 env 管理；
#    如需开启在服务 ExecStart 显式追加 -password <密码>）：
#       sudo nano /etc/opencode2api/manager.env
#       sudo systemctl daemon-reload && sudo systemctl restart opencode2api
#
# 本仓库脚本源：scripts/opencode2api.service + scripts/manager.env
# （tauri.conf.json bundle.linux.deb.files 负责装入 deb 包）。
#
# 下面是手动安装（未用 deb 自动注册时）的备用方式：
#   sudo cp scripts/opencode2api.service /etc/systemd/system/
#   sudo cp scripts/manager.env /etc/opencode2api/manager.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now opencode2api
#
# 常用运维：
#   journalctl -u opencode2api -f            # 实时日志
#   sudo systemctl restart opencode2api
#   sudo nano /etc/opencode2api/manager.env  # 改端口/监听地址/网关密钥后：
#   sudo systemctl daemon-reload && sudo systemctl restart opencode2api
#
# 统一网关端口（自定义网关 API 监听端口，非本服务端口）：
#   优先级：OPCODE2API_GATEWAY_PORT env > config.json 的 gateway_port > 默认 40080
#   （WebUI「统一网关」卡片可设，保存即生效，建议用 WebUI 设置）。
#   ⚠️ 若在 manager.env 取消注释设置该 env，env 优先级最高，WebUI 改的端口
#      会在重启后被压回 env 值。
# 统一网关密钥：默认 sk-unified-local；OPCODE2API_GATEWAY_KEY env > config.json 的
#   gateway_key > 默认 sk-unified-local（自定义建议在 WebUI「统一网关」卡片设置）。

[Unit]
Description=opencode2api Manager (headless Web UI, deb install)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode2api
Group=opencode2api
# deb 安装的二进制路径为 /usr/bin/opencode2api
# -config 无需指定：壳自动使用数据目录下的 config.json（data_dir 见 manager.env）
EnvironmentFile=-/etc/opencode2api/manager.env
ExecStart=/usr/bin/opencode2api --headless -port ${MANAGER_PORT} -listen ${MANAGER_LISTEN}
Restart=on-failure
RestartSec=5
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
