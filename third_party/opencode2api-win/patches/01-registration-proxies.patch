+// registrationProxyURLs parses warp.registration_proxies into a rotation list.
+// When empty it falls back to the single registry proxy so existing configs keep
+// their behaviour.
+func registrationProxyURLs(cfg config.Config) []*url.URL {
+	var out []*url.URL
+	for _, raw := range cfg.Warp.RegistrationProxies {
+		clean, _ := config.ParseProxyEntry(raw)
+		if clean == "" || clean == "direct" {
+			continue
+		}
+		parsed, err := url.Parse(clean)
+		if err != nil || parsed.Scheme == "" || parsed.Host == "" {
+			continue
+		}
+		out = append(out, parsed)
+	}
+	if len(out) == 0 {
+		if single := registryProxyURL(cfg); single != nil {
+			out = append(out, single)
+		}
+	}
+	return out
+}
