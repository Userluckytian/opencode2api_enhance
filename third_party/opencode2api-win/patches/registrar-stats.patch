+	// proxy labels the registration source ("direct" when none). The panel
+	// attributes WARP exits to nodes through this string.
+	proxy string
+	// counters back the per-node status column: attempts / successes / failures
+	// and the last failure reason. They are cumulative for the process lifetime.
+	attempts  atomic.Uint64
+	successes atomic.Uint64
+	failures  atomic.Uint64
+	errMu     sync.Mutex
+	lastErr   string
+	lastAt    time.Time
+
 	mu          sync.Mutex
 	blockedTill time.Time
 }
 
+// record notes one registration attempt. Errors keep their message and time so
+// the panel can say why a node failed instead of a bare red dot.
+func (r *registrar) record(err error) {
+	if r == nil {
+		return
+	}
+	r.attempts.Add(1)
+	r.errMu.Lock()
+	r.lastAt = time.Now()
+	if err != nil {
+		r.lastErr = err.Error()
+	}
+	r.errMu.Unlock()
+	if err != nil {
+		r.failures.Add(1)
+	} else {
+		r.successes.Add(1)
+	}
+}
