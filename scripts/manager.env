# opencode2api 管理器 systemd 环境变量模板
# 由 deb 包安装到 /etc/opencode2api/manager.env（系统服务读取本文件）。
#
# ⚠️⚠️ 重要：修改本文件（端口/监听地址/网关密钥等）后，必须执行以下命令
#    才生效（systemd 在服务启动时读取 EnvironmentFile，不会自动重载）：
#
#       sudo systemctl daemon-reload && sudo systemctl restart opencode2api
#
#    若只在 WebUI「统一网关」卡片里改端口/密钥（写入 config.json），保存即
#    生效，无需改本文件，也无需重启服务。

# 管理器 HTTP 监听端口（WebUI 端口；headless 壳 -port）
MANAGER_PORT=60000

# 监听地址：127.0.0.1 = 仅本机；0.0.0.0 = 全接口（公网部署务必配合防火墙/反代）
MANAGER_LISTEN=127.0.0.1

# 数据目录（实例配置、运行态、统一网关配置等均在此）
OPCODE2API_DATA_DIR=/var/lib/opencode2api

# 统一网关鉴权密钥（可选，至少 8 字符）：默认即 sk-unified-local，无需设置。
# 如需自定义：优先在 WebUI「统一网关」卡片设置（写入 config.json，保存即生效）。
# 取消下面注释可在本文件用 env 设置，但注意 env 优先级最高，会压过 WebUI 的修改。
# 注意：管理 WebUI 鉴权默认关闭（core 默认空密码，不在此文件管理）。
# 如需开启管理鉴权，请在 opencode2api.service 的 ExecStart 显式追加 -password <密码>。
# OPCODE2API_GATEWAY_KEY=sk-unified-local

# 统一网关监听端口（可选，1-65535；留空 = 用 config.json gateway_port / 默认 40080）
# ⚠️ 强烈建议在 WebUI「统一网关」卡片设置端口（写入 config.json，保存即生效）；
#    取消下面注释会用本文件值覆盖 config.json——在 WebUI 改的端口会在重启后被
#    此值压回，造成「改了端口重启又变回去」。仅在确需 env 固定端口时才取消注释。
# OPCODE2API_GATEWAY_PORT=40080
