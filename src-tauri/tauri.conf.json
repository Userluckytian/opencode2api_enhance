{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opencode2api",
  "version": "2.0.6",
  "identifier": "com.opencode2api.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "opencode2api",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QjlBOTlENkJGMkJDOTAKUldTUXZQSnJuYW01eGlVMXBNN0kwR3JhNlcwcmtoZUJHVXlyS0o1VVNQUWJPaklTNWh6ZHdVaWoK",
      "endpoints": [
        "https://github.com/Userluckytian/opencode2api_enhance/releases/download/updater-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "LLM 代理管理器（OpenCode 免费层 + 自定义供应商，桌面/headless WebUI）",
    "longDescription": "基于 Tauri 2 的本地 LLM 代理管理器，三进程架构：40000 管理面板 + 40080 OpenCode 免费层引擎（opencode2api-win，GPL-3.0 独立进程）+ 50080 自定义/插件供应商服务。支持多供应商多 Key 轮询、调用日志与统计。桌面（Windows/Linux）与 headless WebUI 双模式。",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-opencode2api.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "files": {
          "/etc/systemd/system/opencode2api.service": "../scripts/opencode2api.service",
          "/etc/opencode2api/manager.env": "../scripts/manager.env"
        },
        "preInstallScript": "../scripts/preinst.sh",
        "postInstallScript": "../scripts/postinst.sh",
        "preRemoveScript": "../scripts/prerm.sh",
        "postRemoveScript": "../scripts/postrm.sh"
      }
    },
    "macOS": {
      "dmg": {}
    },
    "resources": {
      "../dist/index.html": "bin/dist/index.html",
      "../dist/assets/": "bin/dist/assets/",
      "../dist/app-icon.png": "bin/dist/app-icon.png",
      "target/release/WebView2Loader.dll": "WebView2Loader.dll",
      "../third_party/opencode2api-win/": "third_party/opencode2api-win/"
    }
  }
}
